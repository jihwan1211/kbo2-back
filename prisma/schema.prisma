// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model team {
  id                   Int      @id @default(autoincrement())
  symbol               String   @db.VarChar(4)
  name                 String   @db.VarChar(10)
  win                  Int
  runnerUp             Int      @map("runner_up")
  players              player[]
  batterOppositionRecords   batter_daily_record[]
  pitcherOppositionRecords  pitcher_daily_record[]
  homeGames           game[]   @relation("HomeTeam")
  awayGames           game[]   @relation("AwayTeam")
}

model player {
  id                   Int      @id @default(autoincrement())
  kboId                Int      @map("kbo_id") @unique
  profileImage         String?  @map("profile_image") @db.VarChar(256)
  name                 String?  @db.VarChar(64)
  birth                DateTime? @db.Date
  backNumber           String?  @map("back_number") @db.VarChar(4)
  school               String?  @db.VarChar(64)
  team                 team?    @relation(fields: [teamId], references: [id])
  teamId               Int?     @map("team")
  position             String?  @db.VarChar(4)
  isActive             Boolean? @default(false) @map("is_active")
  batterDailyRecords  batter_daily_record[]
  pitcherDailyRecords pitcher_daily_record[]
  batterYearlyRecords batter_yearly_record[]
  pitcherYearlyRecords pitcher_yearly_record[]
  milestoneRecords    milestone_record[]
  roaster             roaster[]
}

model batter_daily_record {
  id           Int       @id @default(autoincrement())
  season       String    @db.VarChar(4)  
  date         DateTime  @db.Date
  player       player    @relation(fields: [fkPlayerId], references: [kboId])
  fkPlayerId   Int       @map("fk_player_id")
  team         team     @relation(fields: [fkOppositionTeamId], references: [id])
  fkOppositionTeamId Int @map("fk_opposition_team_id")
  G            Int       
  PA           Int       
  AB           Int       
  R            Int       
  H            Int    
  twoB         Int       @map("two_B")
  threeB       Int       @map("three_B")
  HR           Int       
  TB           Int       
  RBI          Int       
  SB           Int       
  CS           Int     
  BB           Int       
  HBP          Int      
  SO           Int
  GDP          Int       
}

model pitcher_daily_record {
  id           Int       @id @default(autoincrement())
  season       String    @db.VarChar(4)
  date         DateTime  @db.Date
  player       player    @relation(fields: [fkPlayerId], references: [kboId])
  fkPlayerId   Int       @map("fk_player_id")
  team         team      @relation(fields: [fkOppositionTeamId], references: [id])
  fkOppositionTeamId Int @map("fk_opposition_team_id")
  G            Int       
  CG           Int       
  SHO          Int       
  W            Int       
  L            Int       
  SV           Int       
  HLD          Int    
  TBF          Int       
  IP           String    @db.VarChar(12)
  H            Int       
  HR           Int       
  BB           Int       
  HBP          Int       
  SO           Int       
  R            Int       
  ER           Int     
  role         String     @db.VarChar(2)  
}

model batter_yearly_record {
  id           Int       @id @default(autoincrement())
  season       String    @db.VarChar(4)
  year         Int       @db.SmallInt
  player       player    @relation(fields: [fkPlayerId], references: [kboId])
  fkPlayerId   Int       @map("fk_player_id")
  G            Int       
  PA           Int       
  AB           Int       
  R            Int       
  H            Int    
  twoB         Int       @map("two_B")
  threeB       Int       @map("three_B")
  HR           Int       
  TB           Int       
  RBI          Int       
  SB           Int       
  CS           Int     
  BB           Int       
  HBP          Int      
  SO           Int
  GDP          Int  
  E            Int     
}

model pitcher_yearly_record {
  id           Int       @id @default(autoincrement())
  season       String    @db.VarChar(4)
  year         Int       @db.SmallInt
  player       player    @relation(fields: [fkPlayerId], references: [kboId])
  fkPlayerId   Int       @map("fk_player_id")
  G            Int       
  CG           Int       
  SHO          Int       
  W            Int       
  L            Int       
  SV           Int       
  HLD          Int   
  WPCT         Float       
  TBF          Int       
  IP           String    @db.VarChar(12)
  H            Int       
  HR           Int       
  BB           Int       
  HBP          Int       
  SO           Int       
  R            Int       
  ER           Int       
}

model milestone_definition {
  id           Int       @id @default(autoincrement())
  record       String   
  description  String 
  position     String     
  spanYears    Int?      @map("span_years")
  milestoneConditions milestone_condition[]
  milestoneRecords    milestone_record[]
}

model milestone_condition {
  id           Int       @id @default(autoincrement())
  milestoneDefiniton  milestone_definition   @relation(fields: [fkMilestoneDefinitionId], references: [id])
  fkMilestoneDefinitionId  Int  @map("fk_milestone_definition_id")
  category     String     
  target       Int
}

model milestone_record {
  id           Int       @id @default(autoincrement())
  milestoneDefiniton  milestone_definition   @relation(fields: [fkMilestoneDefinitionId], references: [id])
  fkMilestoneDefinitionId  Int  @map("fk_milestone_definition_id")
  player       player    @relation(fields: [fkPlayerId], references: [kboId])
  fkPlayerId   Int       @map("fk_player_id")
  date         DateTime  @default(now()) @db.Date
}

model game {
  id            Int       @id @default(autoincrement())
  date          DateTime  @db.Timestamp
  homeTeam      team      @relation("HomeTeam", fields : [fkHomeTeamId], references : [id])
  fkHomeTeamId  Int       @map("fk_home_team_id")
  awayTeam      team      @relation("AwayTeam", fields : [fkAwayTeamId], references : [id])
  fkAwayTeamId  Int       @map("fk_away_team_id")
  homeTeamScore Int?       @map("home_team_score")
  awayTeamScore Int?       @map("away_team_score")
  memo          String?    @db.VarChar(16)  

  @@unique([date, fkHomeTeamId, fkAwayTeamId])
}

model roaster {
  id            Int       @id @default(autoincrement())
  date          DateTime  @db.Date
  player        player    @relation(fields : [fkPlayerId], references : [kboId])
  fkPlayerId    Int       @map("fk_player_id")
}